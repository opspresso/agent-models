# Use the shared Agent platform database. Only agent_models_ tables are initialized.
DATABASE_URL=postgres://agent_platform:agent_platform@localhost:5433/agent_platform
# Generate each once: openssl rand -base64 32. Preserve them across deployments.
AES_ENCRYPTION_KEY=
AUTH_SECRET=
AUTH_BASE_URL=http://localhost:3400

# Register Agent Models in Studio Settings -> Platform connections.
OIDC_ISSUER=http://localhost:3000/api/auth
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_PROVIDER_ID=studio
# Defaults include the required identity and Models scopes.
# OIDC_SCOPES=openid email profile offline_access platform:identity models:read models:invoke models:manage usage:read

MODEL_REQUEST_TIMEOUT_MS=600000
MODEL_MAX_CONCURRENT_REQUESTS=64
MODEL_MAX_REQUEST_BYTES=100663296
NEXT_TELEMETRY_DISABLED=1

# Optional: Bedrock uses the standard AWS credential chain and the endpoint's signing region.
# AWS_REGION=ap-northeast-2
